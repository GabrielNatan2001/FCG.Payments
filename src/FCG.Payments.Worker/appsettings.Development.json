{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=fcg_payments;Username=postgres;Password=postgres"
  },
  "MessageBusConfigs": {
    "Host": "amqp://guest:guest@localhost:5672/",
    "RetryCount": "5"
  },
  "Publishers": {
    "PaymentProcessed": {
      "Exchange": "fcg.payment.processed",
      "CatalogRoutingKey": "catalog.payment-processed",
      "NotificationsRoutingKey": "notifications.payment-processed"
    }
  },
  "Workers": {
    "OrderPlaced": {
      "Ativo": true,
      "Exchange": "fcg.order.placed",
      "RoutingKey": "payments.order-placed"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "FCG.Payments": "Debug"
    }
  }
}
